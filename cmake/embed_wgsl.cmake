# Writes a C++ header holding the UI shader as WGSL, for the WebGPU renderer (WEB_PLAN.md, G86).
#
#   cmake -DINPUT=<slangc's .wgsl> -DOUTPUT=<header> -P embed_wgsl.cmake
#
# slangc turns the push-constant block into `var<immediate>`, which WebGPU has only as an
# extension. It becomes a uniform buffer at binding 3 instead, read at a dynamic offset per run.
# The header is committed, like ui_spirv.h, so a build never needs slangc.

file(READ "${INPUT}" wgsl)
string(REPLACE "requires immediate_address_space;\n" "" wgsl "${wgsl}")
string(REGEX REPLACE "var<immediate> ([A-Za-z0-9_]+) : ([A-Za-z0-9_]+);"
       "@binding(3) @group(0) var<uniform> \\1 : \\2;" wgsl "${wgsl}")
if(wgsl MATCHES "immediate")
    message(FATAL_ERROR "embed_wgsl: slangc's output still uses immediates; the rewrite no longer matches it")
endif()
if(NOT wgsl MATCHES "var<uniform>")
    message(FATAL_ERROR "embed_wgsl: no push block found to rewrite as a uniform buffer")
endif()
# Clip space: Vulkan's y points down and WebGPU's up, while both put the framebuffer's origin, which
# scissors and the fragment shader's position use, at the top left. The vertex entry is kept as
# slangc wrote it under another name, and a wrapper turns its y over.
string(REGEX MATCH "@vertex\nfn vertexMain\\( ([A-Za-z0-9_]+) : ([A-Za-z0-9_]+), @builtin\\(vertex_index\\) ([A-Za-z0-9_]+) : u32\\) -> ([A-Za-z0-9_]+)" vertex "${wgsl}")
if(NOT vertex)
    message(FATAL_ERROR "embed_wgsl: slangc's vertex entry no longer looks as this script expects")
endif()
set(input_type "${CMAKE_MATCH_2}")
set(output_type "${CMAKE_MATCH_4}")
string(REGEX MATCH "struct ${output_type}\n{[^}]*@builtin\\(position\\) ([A-Za-z0-9_]+) : vec4<f32>" position "${wgsl}")
if(NOT position)
    message(FATAL_ERROR "embed_wgsl: no position output found in ${output_type}")
endif()
set(position_field "${CMAKE_MATCH_1}")
# A function that is not an entry point may not take a builtin, so the inner one takes a plain u32.
string(REGEX REPLACE "@vertex\nfn vertexMain\\(([^)]*)@builtin\\(vertex_index\\) " "fn vertexMain_vulkan(\\1" wgsl "${wgsl}")
string(APPEND wgsl "
@vertex
fn vertexMain(prim : ${input_type}, @builtin(vertex_index) vertex : u32) -> ${output_type}
{
    var out = vertexMain_vulkan(prim, vertex);
    out.${position_field}.y = -out.${position_field}.y;
    return out;
}
")

if(wgsl MATCHES "\\)wgsl\"")
    message(FATAL_ERROR "embed_wgsl: the shader contains the raw string delimiter")
endif()

file(WRITE "${OUTPUT}" "// Generated by cmake/embed_wgsl.cmake -- do not edit. Regenerate with the vui_shaders
// target (G86). Compiled by: slangc from ui.slang, -target wgsl
#pragma once

namespace vui::ui::detail::shaders
{
inline constexpr char ui_wgsl[] = R\"wgsl(${wgsl})wgsl\";
} // namespace vui::ui::detail::shaders
")
